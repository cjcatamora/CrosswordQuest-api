      "name": "1 It works",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 201\", function () {\n  pm.response.to.have.status(201);\n});\npm.collectionVariables.set(\"setId\", pm.response.json().id);\npm.test(\"has an id and the host\", function () {\n  const j = pm.response.json();\n  pm.expect(j.id).to.be.a(\"number\");\n  pm.expect(j).to.have.property(\"host_id\");\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Demo-User",
            "value": "{{host}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{ \"name\": \"Philippine Literature {{$timestamp}}\" }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/question-sets",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "question-sets"
          ]
        }
      },
      "response": []
