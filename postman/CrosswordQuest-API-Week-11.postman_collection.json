    {
      "name": "Module 1 - Question sets",
      "item": [
        {
          "name": "It works",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.collectionVariables.set(\"setId\", pm.response.json().id);",
                  "pm.test(\"has an id and the host\", function () {",
                  "  const j = pm.response.json();",
                  "  pm.expect(j.id).to.be.a(\"number\");",
                  "  pm.expect(j).to.have.property(\"host_id\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Demo-User",
                "value": "{{host}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/question-sets",
            "body": {
              "mode": "raw",
              "raw": "{ \"name\": \"Philippine Literature {{$timestamp}}\" }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
