{
  "info": {
    "name": "CrosswordQuest API - Week 12 Sessions",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001/api/v1"
    },
    {
      "key": "host",
      "value": "2099-0001"
    },
    {
      "key": "player",
      "value": "2099-0002"
    },
    {
      "key": "player2",
      "value": "2099-0003"
    },
    {
      "key": "setId",
      "value": ""
    },
    {
      "key": "code",
      "value": ""
    },
    {
      "key": "playerId",
      "value": ""
    },
    {
      "key": "code2",
      "value": ""
    },
    {
      "key": "dupName",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Make a question set",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 201\", function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "pm.collectionVariables.set(\"setId\", pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Demo-User",
            "value": "{{host}}",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/question-sets",
        "body": {
          "mode": "raw",
          "raw": "{ \"name\": \"Session test {{$timestamp}}\" }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Start a game",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 201\", function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "const j = pm.response.json();",
              "pm.test(\"WAITING with a six-digit code\", function () {",
              "  pm.expect(j.status).to.eql(\"WAITING\");",
              "  pm.expect(j.code).to.match(/^[1-9][0-9]{5}$/);",
              "});",
              "pm.collectionVariables.set(\"code\", j.code);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Demo-User",
            "value": "{{host}}",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/sessions",
        "body": {
          "mode": "raw",
          "raw": "{ \"set_id\": {{setId}} }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Read a game",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/sessions/{{code}}"
      }
    },
    {
      "name": "Join",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 201\", function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "const j = pm.response.json();",
              "pm.test(\"new seat\", function () { pm.expect(j.rejoined).to.eql(false); });",
              "pm.collectionVariables.set(\"playerId\", j.player_id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Demo-User",
            "value": "{{player}}",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/sessions/{{code}}/players",
        "body": {
          "mode": "raw",
          "raw": "{ \"nickname\": \"Ana\" }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Join again",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const j = pm.response.json();",
              "pm.test(\"same seat, rejoined\", function () {",
              "  pm.expect(j.rejoined).to.eql(true);",
              "  pm.expect(j.player_id).to.eql(Number(pm.collectionVariables.get(\"playerId\")));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Demo-User",
            "value": "{{player}}",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/sessions/{{code}}/players",
        "body": {
          "mode": "raw",
          "raw": "{ \"nickname\": \"Ana\" }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "List players",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test(\"only public fields\", function () {",
              "  const p = pm.response.json()[0];",
              "  pm.expect(p).to.have.keys([\"nickname\", \"color\", \"score\", \"streak\"]);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/sessions/{{code}}/players"
      }
    },
    {
      "name": "Start the game",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "X-Demo-User",
            "value": "{{host}}",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/sessions/{{code}}",
        "body": {
          "mode": "raw",
          "raw": "{ \"status\": \"PLAYING\" }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Join a started game",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 409\", function () {",
              "  pm.response.to.have.status(409);",
              "});",
              "pm.test(\"error code is SESSION_NOT_JOINABLE\", function () {",
              "  pm.expect(pm.response.json().error.code).to.eql(\"SESSION_NOT_JOINABLE\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Demo-User",
            "value": "{{player2}}",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/sessions/{{code}}/players",
        "body": {
          "mode": "raw",
          "raw": "{ \"nickname\": \"Ben\" }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Rejoin a started game",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Demo-User",
            "value": "{{player}}",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/sessions/{{code}}/players",
        "body": {
          "mode": "raw",
          "raw": "{ \"nickname\": \"Ana\" }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "End the game",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "X-Demo-User",
            "value": "{{host}}",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/sessions/{{code}}",
        "body": {
          "mode": "raw",
          "raw": "{ \"status\": \"FINISHED\" }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "A finished game cannot run again",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 409\", function () {",
              "  pm.response.to.have.status(409);",
              "});",
              "pm.test(\"error code is INVALID_STATUS_CHANGE\", function () {",
              "  pm.expect(pm.response.json().error.code).to.eql(\"INVALID_STATUS_CHANGE\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "X-Demo-User",
            "value": "{{host}}",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/sessions/{{code}}",
        "body": {
          "mode": "raw",
          "raw": "{ \"status\": \"PLAYING\" }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "The code is not six digits",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 400\", function () {",
              "  pm.response.to.have.status(400);",
              "});",
              "pm.test(\"error code is VALIDATION_FAILED\", function () {",
              "  pm.expect(pm.response.json().error.code).to.eql(\"VALIDATION_FAILED\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/sessions/12"
      }
    },
    {
      "name": "The code does not exist",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 404\", function () {",
              "  pm.response.to.have.status(404);",
              "});",
              "pm.test(\"error code is SESSION_NOT_FOUND\", function () {",
              "  pm.expect(pm.response.json().error.code).to.eql(\"SESSION_NOT_FOUND\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/sessions/999999"
      }
    },
    {
      "name": "Start another game",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 201\", function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "pm.collectionVariables.set(\"code2\", pm.response.json().code);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Demo-User",
            "value": "{{host}}",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/sessions",
        "body": {
          "mode": "raw",
          "raw": "{ \"set_id\": {{setId}} }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Join as player 1",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 201\", function () {",
              "  pm.response.to.have.status(201);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Demo-User",
            "value": "{{player}}",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/sessions/{{code2}}/players",
        "body": {
          "mode": "raw",
          "raw": "{ \"nickname\": \"Ana\" }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "A taken nickname",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 409\", function () {",
              "  pm.response.to.have.status(409);",
              "});",
              "pm.test(\"error code is NICKNAME_TAKEN\", function () {",
              "  pm.expect(pm.response.json().error.code).to.eql(\"NICKNAME_TAKEN\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Demo-User",
            "value": "{{player2}}",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/sessions/{{code2}}/players",
        "body": {
          "mode": "raw",
          "raw": "{ \"nickname\": \"Ana\" }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "A set used by a game cannot be deleted",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 409\", function () {",
              "  pm.response.to.have.status(409);",
              "});",
              "pm.test(\"error code is QUESTION_SET_IN_USE\", function () {",
              "  pm.expect(pm.response.json().error.code).to.eql(\"QUESTION_SET_IN_USE\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "X-Demo-User",
            "value": "{{host}}",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/question-sets/{{setId}}"
      }
    },
    {
      "name": "Make a set to repeat",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"dupName\", \"Repeat \" + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 201\", function () {",
              "  pm.response.to.have.status(201);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Demo-User",
            "value": "{{host}}",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/question-sets",
        "body": {
          "mode": "raw",
          "raw": "{ \"name\": \"{{dupName}}\" }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "A taken set name",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 409\", function () {",
              "  pm.response.to.have.status(409);",
              "});",
              "pm.test(\"error code is QUESTION_SET_NAME_TAKEN\", function () {",
              "  pm.expect(pm.response.json().error.code).to.eql(\"QUESTION_SET_NAME_TAKEN\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Demo-User",
            "value": "{{host}}",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/question-sets",
        "body": {
          "mode": "raw",
          "raw": "{ \"name\": \"{{dupName}}\" }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ]
}